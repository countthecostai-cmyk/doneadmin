# Supabase (Project Settings -> API) — SAME project as the Done and Doer
# apps. All three share one Supabase backend; there is no per-app database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — only used here for issuing refunds on resolved disputes. This app
# does NOT own the webhook or create Checkout Sessions — that's the Done
# (customer) app.
STRIPE_SECRET_KEY=

# Public site URL (no trailing slash) — used for Supabase email confirmation
# links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
